# ==============================================================================
# CUNY SPS Club Social & Student Organization Platform
# Environment Configuration Template
# ==============================================================================

# Supabase Real-Time Hosted Database Configuration
# 1. Create a free project at https://supabase.com
# 2. In SQL Editor, run the script located at ./supabase/schema.sql
# 3. Copy your Project URL & Anon/Public Key from Project Settings -> API
# 4. Copy this file to .env.local and fill in the values below:

VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Microsoft Entra ID (Azure AD SAML 2.0 / OAuth) for CUNY SSO
# Students and staff can log in using their official @login.cuny.edu or @spsmail.cuny.edu credentials
VITE_CUNY_ENTRA_TENANT_ID=
VITE_CUNY_ENTRA_CLIENT_ID=
